# ---------------------------------------------------------------------------
# Public (shipped to the browser)
# ---------------------------------------------------------------------------
# "mainnet" (QIE Mainnet, chain 1990) or "testnet" (QIE Testnet, chain 1983)
NEXT_PUBLIC_QIE_NETWORK=mainnet
# PactiqVault address printed by `forge script script/DeployPactiq.s.sol`
NEXT_PUBLIC_PACTIQ_CONTRACT_ADDRESS=
# Public URL of the deployed app (invite links, share cards, badge metadata), no trailing slash
NEXT_PUBLIC_APP_URL=
# Optional: override the RPC (e.g. http://127.0.0.1:8545 for a local anvil chain)
# NEXT_PUBLIC_RPC_URL=

# ---------------------------------------------------------------------------
# Server-only secrets (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Verifier key. Its address must equal the contract's oracleSigner.
# Generate a fresh one with `cast wallet new`. It never needs funds.
ORACLE_PRIVATE_KEY=
# Vision verifier: a 0G Compute Router key (https://pc.0g.ai). Any OpenAI-compatible API works.
LLM_API_KEY=
# Optional: model id, must accept images (default: gpt-5.4-mini)
# LLM_MODEL=
# Optional: another OpenAI-compatible endpoint (default: https://router-api.0g.ai/v1)
# LLM_BASE_URL=
# Alternative to LLM_API_KEY: a Google AI Studio key, used only when LLM_API_KEY is empty
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Optional: separate secret for daily challenge codes (defaults to one derived from ORACLE_PRIVATE_KEY)
# CHALLENGE_SECRET=

# Shared store for rate limits and reminder subscribers (free database at https://upstash.com).
# Without it both live in server memory: fine locally, not on a serverless host.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Push reminders when the app is closed. Generate the pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact the push services can reach you at, e.g. mailto:you@example.com (default: the app URL)
# VAPID_SUBJECT=
# Secret your scheduler sends as "Authorization: Bearer ..." to GET /api/push/cron (call it hourly)
CRON_SECRET=

# Optional: put the whole site behind one password (visitors see /gate first). Leave unset for an open site.
# SITE_PASSWORD=

# PactiqRouter address printed by the deploy script. Swaps in the app go through it so they are
# attributed to Pactiq on-chain. Leave empty to trade on QIEDEX directly.
NEXT_PUBLIC_PACTIQ_ROUTER_ADDRESS=

# PactiqCampaign address printed by `forge script script/DeployCampaign.s.sol`. Leave empty and
# /launch shows the planned terms as a preview.
NEXT_PUBLIC_CAMPAIGN_ADDRESS=

# Optional: override QIE ecosystem addresses (defaults: QIE Mainnet)
# NEXT_PUBLIC_QUSDC_ADDRESS=
# NEXT_PUBLIC_QIEDEX_ROUTER=
# NEXT_PUBLIC_WQIE_ADDRESS=

# Testnet/local only: approve any photo without AI. Ignored on mainnet.
# PACTIQ_DEMO_VERIFIER=true
