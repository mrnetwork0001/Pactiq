# Deployer (becomes contract owner). Needs QIE for gas (+ SEED_REWARD_POOL_WEI if set).
PRIVATE_KEY=
# Address of the verifier key used by the frontend (ORACLE_PRIVATE_KEY). Use a separate key.
ORACLE_SIGNER_ADDRESS=
# Optional. Defaults to the QIE Oracle QIE/USDT feed on mainnet, none on testnet.
# PRICE_FEED_ADDRESS=0x3Bc617cF3A4Bb77003e4c556B87b13D556903D17
# Optional. Stake asset next to QIE. Defaults to QUSDC (0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5) on mainnet.
# STABLECOIN_ADDRESS=
# Optional. Minimum daily stake in its smallest unit (default 100000 = 0.10 QUSDC).
# STABLECOIN_MIN_PER_DAY=100000
# Optional. An existing QIE ID checker. On mainnet a QieNameVerifier for QIE's registries is deployed by default.
# QIE_NAMES_ADDRESS=
# Optional. Seed the completion-bonus pool at launch, in wei (e.g. 50 QIE = 50000000000000000000).
# SEED_REWARD_POOL_WEI=0
# Badge metadata base URL: your deployed app + /api/badge/ (token id is appended)
BADGE_BASE_URI=https://your-app.vercel.app/api/badge/
# Optional first cause for charity mode (add more later with setCharity). Use a real, verified address.
# CHARITY_ADDRESS=
# CHARITY_NAME=
